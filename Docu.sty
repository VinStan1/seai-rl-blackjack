% SLIDE 21
\begin{frame}{Conclusions and Limits}
\small
\begin{columns}[T]
\column{0.50\textwidth}
\textbf{What the experiments support}
\begin{itemize}
    \item Standard tabular methods learn similar strong Hit/Stick policies; fresh validation favours SARSA only slightly.
    \item Hidden finite-shoe dynamics do not materially damage aggregate reward under the tested rules.
    \item Hi-Lo information increases sample demand without a clear reward advantage here.
    \item Raw exact composition breaks tabular coverage; Double DQN recovers performance through generalisation.
\end{itemize}

\column{0.46\textwidth}
\textbf{What remains to establish}
\begin{itemize}
    \item repeat the selected DQN with 10--20 fresh seeds;
    \item run paired, pre-specified cross-environment comparisons;
    \item measure memory and learning curves, not only final reward and time;
    \item test compact composition features or recurrent/belief-state agents;
    \item expand the environment before drawing conclusions about Double, Split, Insurance or betting.
\end{itemize}
\end{columns}

\vspace{0.05cm}
\CautionBox{A negative mean reward is expected in fixed-stake casino Blackjack. This project compares policies under a deliberately restricted action set; it is not a full casino-strategy simulator.}
\end{frame}

