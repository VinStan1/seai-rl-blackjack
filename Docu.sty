\begin{frame}{Double DQN: Function Approximation for Composition States}
\begin{columns}[T]
\column{0.46\textwidth}
\textbf{Normalized 13-feature input}
\[
\left[\frac{p}{21},\frac{d}{10},a,
\frac{n_A}{24},\ldots,\frac{n_9}{24},\frac{n_{10}}{96}\right]
\]

\centering
\begin{tikzpicture}[node distance=0.18cm,box/.style={draw,rounded corners,fill=blue!8,minimum height=.68cm,align=center,font=\scriptsize}]
\node[box] (in) {13 inputs};
\node[box,right=of in] (h1) {$h$ ReLU};
\node[box,right=of h1] (h2) {$h$ ReLU};
\node[box,right=of h2] (out) {2 Q-values};
\draw[-{Latex}] (in)--(h1);
\draw[-{Latex}] (h1)--(h2);
\draw[-{Latex}] (h2)--(out);
\end{tikzpicture}

\column{0.50\textwidth}
\textbf{Implemented stabilisers}
\begin{itemize}
    \item replay buffer $100{,}000$, batch $64$ or $128$;
    \item Adam optimiser and Huber loss;
    \item gradient norm clipping at 10;
    \item one update every 4 actions after 1,000 actions;
    \item target network copied every 1,000 actions.
\end{itemize}

\textbf{Double target}
\[
a^*=\arg\max_a Q_{\mathrm{online}}(s',a),
\]
\[
y=r+\gamma Q_{\mathrm{target}}(s',a^*).
\]
\end{columns}

\vfill
{\tiny This separates action selection from evaluation, following van Hasselt, Guez and Silver (AAAI 2016).}
\end{frame}

