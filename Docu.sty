\begin{frame}{Motivation and Research Questions}
\begin{itemize}
    \item How do first-visit Monte Carlo, SARSA and Q-learning compare in Blackjack?
    \item What changes when independent card draws become a persistent finite shoe?
    \item Does exposing a Hi-Lo count or the full unseen-card composition help?
    \item Can function approximation overcome the resulting state-space explosion?
\end{itemize}

\vspace{0.45cm}
\begin{center}
\textbf{Core idea:} hold the rules fixed and vary the learner's information.
\end{center}
\end{frame}

% SLIDE 3
\begin{frame}{Blackjack as a Small Episodic Markov Decision Process}
\small
\begin{columns}[T]
\column{0.31\textwidth}
\textbf{Rules in this repository}
\begin{itemize}
    \item Actions: \textit{Stick} (0) or \textit{Hit} (1).
    \item Dealer draws to at least 17.
    \item Terminal reward: $R\in\{-1,0,+1\}$.
    \item Natural blackjack follows Sutton--Barto rules.
    \item No betting, double, split, surrender or insurance.
\end{itemize}

\column{0.31\textwidth}
\textbf{Standard observation}
\[
    s=(p,d,a)
\]
\begin{itemize}
    \item $p$: player's current total;
    \item $d$: dealer's visible card;
    \item $a$: usable-ace flag.
\end{itemize}
A soft 18 can turn its ace from 11 to 1 after a hit; a hard 18 cannot. The flag therefore prevents two strategically different hands from being merged.

\column{0.32\textwidth}
\textbf{Objective and Markov property}
\[
 \begin{aligned}
 \max_{\pi}\;&\mathbb{E}_{\pi}[G_t],\\[-0.05cm]
 G_t={}&\sum_k\gamma^kR_{t+k+1}.
 \end{aligned}
\]
Here $\gamma=1$ and intermediate rewards are zero, so $G_t$ is the final hand outcome.

\vspace{0.12cm}
With infinite sampling with replacement, $(p,d,a)$ determines the distribution of the next observation and reward:
{\scriptsize
\[
P(s',r\mid h_t,s,a)=P(s',r\mid s,a).
\]}
\end{columns}

\vfill
{\tiny Implementation: \texttt{src/environments/blackjack.py}; rules mirror Gymnasium Blackjack-v1 with \texttt{sab=true}.}
\end{frame}

% SLIDE 4 - Applied comment: expanded the algorithm theory.
\begin{frame}{Algorithms Under Comparison: What Is Actually Updated?}
\small
\begin{columns}[T]
\column{0.32\textwidth}
\begin{block}{First-visit Monte Carlo}
Wait for the hand to finish, then use the observed return:
\[
Q(s,a)\leftarrow Q(s,a)+\frac{G-Q(s,a)}{N(s,a)}.
\]
No bootstrapping and no fixed $\alpha$ in this implementation.
\end{block}

\column{0.32\textwidth}
\begin{block}{SARSA: on-policy TD}
Update every action using the action actually selected next:
\[
\begin{gathered}
y=r+\gamma Q(s',a'),\\
Q\leftarrow Q+\alpha(y-Q).
\end{gathered}
\]
It learns the value of its exploratory policy.
\end{block}

\column{0.32\textwidth}
\begin{block}{Q-learning: off-policy TD}
Update every action toward the greedy next action:
\[
\begin{gathered}
y=r+\gamma\max_{a'}Q(s',a'),\\
Q\leftarrow Q+\alpha(y-Q).
\end{gathered}
\]
Behaviour may explore while the target is greedy.
\end{block}
\end{columns}

\vspace{0.15cm}
\CautionBox{All three use an $\epsilon$-greedy behaviour policy during training and deterministic greedy actions during evaluation. Linear schedules interpolate from $\epsilon_{start}$ to $\epsilon_{end}$ over the configured fraction of training.}
\end{frame}

