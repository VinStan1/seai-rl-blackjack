% SLIDE 11
\begin{frame}{Adding Information: Hi-Lo Count State}
\begin{columns}[T]
\column{0.48\textwidth}
\textbf{Observed state}
\[
s=(p,d,a,\widehat{TC})
\]
\[
2\text{--}6:+1,\qquad 7\text{--}9:0,\qquad 10,A:-1.
\]
The running count is updated only for publicly observed cards; the dealer hole card enters when revealed.

\column{0.48\textwidth}
\textbf{Repository-specific true-count bucket}
\[
\widehat{TC}=\operatorname{clip}_{[-20,20]}
\left(\operatorname{int}\frac{RC}{\max(D_{remain},0.25)}\right).
\]
This compact statistic distinguishes some shoes that looked identical in the hidden model, but it also multiplies the tabular state space by up to 41 buckets.
\end{columns}

\vspace{0.35cm}
\CautionBox{Because stakes are fixed and only Hit/Stick is available, this experiment tests whether count information improves playing decisions--not the betting advantage normally associated with card counting.}
\end{frame}

