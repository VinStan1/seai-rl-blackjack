__pycache__/
*.py[cod]
.pytest_cache/
# For every current and future results/<category>/<run>/ directory, track only
# the reproducibility metadata and generated analysis. Trained models and
# per-seed run reports remain ignored.
results/**
!results/.gitkeep
!results/*/
!results/*/*/
!results/*/*/config.json
!results/*/*/summary.json
!results/*/*/analysis/
!results/*/*/analysis/**

# Track all current and future JSON experiment configurations.
experiments/*
!experiments/.gitkeep
!experiments/*.json
