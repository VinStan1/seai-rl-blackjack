{
  "experiment_name": "blackjack_pilot_grid",
  "output_dir": "results/sweeps",
  "workers": 1,
  "environment": {
    "natural": false,
    "sab": true
  },
  "training": {
    "episodes": [20000, 50000, 100000, 200000],
    "seeds": [0, 1, 2, 3, 4]
  },
  "evaluation": {
    "episodes": 10000,
    "seed": 10000
  },
  "algorithms": [
    {
      "name": "monte_carlo",
      "parameters": {
        "epsilon": [0.05, 0.1, 0.2],
        "gamma": [1.0]
      }
    },
    {
      "name": "sarsa",
      "parameters": {
        "epsilon": [0.05, 0.1, 0.2],
        "alpha": [0.01, 0.05, 0.1],
        "gamma": [1.0]
      }
    },
    {
      "name": "q_learning",
      "parameters": {
        "epsilon": [0.05, 0.1, 0.2],
        "alpha": [0.01, 0.05, 0.1],
        "gamma": [1.0]
      }
    }
  ]
}
